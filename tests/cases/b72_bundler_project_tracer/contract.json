{
  "schema": 1,
  "oracle": {
    "typescript": "6.0.3",
    "config_argv": ["tsc", "--pretty", "false", "-p", "<project>/tsconfig.json"],
    "directory_argv": ["tsc", "--pretty", "false", "-p", "<project>"],
    "config_boundary_argv": ["tsc", "--pretty", "false", "--noEmit", "-p", "<project|config>"],
    "input_forms_are_identical": true
  },
  "cli": {
    "directory_argv": ["typokat", "check", "--project-summary", "json", "<project>"],
    "config_argv": ["typokat", "check", "--project-summary", "json", "<project>/tsconfig.json"],
    "stdout": "one normalized JSON object followed by one newline",
    "stderr": "existing rich or compact parse/type/incomplete rendering",
    "exit_precedence": ["usage=2", "project-unsupported-or-incomplete=3", "diagnostics=1", "clean=0"],
    "parse_rejection": "source parse errors precede module inventory because a recovered AST is not authoritative"
  },
  "summary_exact_keys": [
    "schema",
    "profile",
    "config",
    "roots",
    "files",
    "resolutions",
    "project_notices",
    "parse_errors",
    "incomplete",
    "diagnostics"
  ],
  "ordering": "normalized relative path, source line, source column, identity; config notices use the config field position",
  "public_witness_thresholds": {
    "actionable_false_positives": 0,
    "unresolved_modules": 0,
    "skipped_files_or_forms": 0,
    "unsupported_witness_forms": 0,
    "missed_seeded_diagnostics": 0
  },
  "cli_error_cases": [
    {
      "id": "missing_directory_config",
      "exit": 2,
      "stderr": "error: project directory does not contain 'tsconfig.json': <project>\n",
      "tsc": {
        "exit": 1,
        "diagnostics": ["error TS5057: Cannot find a tsconfig.json file at the specified directory: '<project>'."]
      }
    },
    {
      "id": "malformed_config",
      "exit": 2,
      "stderr": "error: malformed project config '<project>/tsconfig.json' at 5:1\n",
      "tsc": {
        "exit": 2,
        "diagnostics": ["tsconfig.json(5,1): error TS1005: '}' expected."]
      }
    },
    {
      "id": "mixed_project_and_source",
      "exit": 2,
      "stderr": "error: project input cannot be combined with source-file inputs\nusage: typokat check [--format rich|compact] [--project-summary json] <input>\n"
    },
    {
      "id": "two_project_inputs",
      "exit": 2,
      "stderr": "error: expected exactly one project input\nusage: typokat check [--format rich|compact] [--project-summary json] <input>\n"
    }
  ],
  "explicit_file_list_controls": {
    "admitted_extensionless": "byte-identical compact stderr and exit status",
    "admitted_js_substitution": "preserve the pre-change TK2307 and exit 1; project mode alone admits .js to .ts substitution",
    "non_clean_forms": [
      "bare-specifier",
      "default-import",
      "default-export",
      "namespace-import",
      "side-effect-import",
      "source-reexport",
      "star-reexport",
      "namespace-reexport",
      "import-equals",
      "export-assignment",
      "export-as-namespace"
    ],
    "mixed_import_classification": "an import declaration containing a default binding collapses to one default-import identity"
  },
